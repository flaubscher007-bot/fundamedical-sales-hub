{
  "name": "Notify on Team Assignment",
  "description": "",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "TeamAssignment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_on_team_assignment",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendNotification",
            "args": {
              "recipient_email": "{{ person_email }}",
              "type": "task_assigned",
              "title": "New Team Assignment",
              "message": "You have been assigned to the {{ team }} team as a {{ role }}",
              "related_entity": "TeamAssignment",
              "related_id": "{{ id }}"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendNotification"
  }
}