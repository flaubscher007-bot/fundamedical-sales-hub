{
  "name": "Leave",
  "type": "object",
  "properties": {
    "bul_name": {
      "type": "string",
      "description": "Business Unit Leader name requesting leave"
    },
    "bul_email": {
      "type": "string",
      "description": "Business Unit Leader email"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Leave start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Leave end date"
    },
    "leave_type": {
      "type": "string",
      "enum": [
        "Annual",
        "Sick",
        "Compassionate",
        "Unpaid",
        "Other"
      ],
      "description": "Type of leave"
    },
    "reason": {
      "type": "string",
      "description": "Reason for leave request"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "approved_by": {
      "type": "string",
      "description": "Name of person who approved/rejected"
    },
    "approval_date": {
      "type": "string",
      "format": "date",
      "description": "Date of approval/rejection"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes on approval/rejection"
    }
  },
  "required": [
    "bul_name",
    "start_date",
    "end_date",
    "leave_type"
  ]
}