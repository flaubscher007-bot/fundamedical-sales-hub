{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "Facebook",
        "LinkedIn",
        "Instagram",
        "YouTube"
      ],
      "description": "Social media platform"
    },
    "post_id": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "post_url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "published_at": {
      "type": "string"
    },
    "fetched_at": {
      "type": "string"
    },
    "media_url": {
      "type": "string",
      "description": "Uploaded media file URL"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "Type of uploaded media"
    },
    "title": {
      "type": "string",
      "description": "Post/session title"
    },
    "ai_advice": {
      "type": "object",
      "description": "AI-generated platform advice",
      "properties": {
        "facebook": {
          "type": "object"
        },
        "linkedin": {
          "type": "object"
        },
        "instagram": {
          "type": "object"
        },
        "youtube": {
          "type": "object"
        }
      }
    },
    "brand_context": {
      "type": "string",
      "description": "Brand/industry context provided by user"
    },
    "chat_history": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Chat conversation history for refinement"
    },
    "session_type": {
      "type": "string",
      "enum": [
        "ai_advisor",
        "fetched"
      ],
      "default": "ai_advisor"
    }
  },
  "required": [
    "session_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management",
            "bul_manager"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$ne": ""
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management",
            "bul_manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management"
          ]
        }
      }
    }
  }
}