{
  "name": "MileageLog",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_location": {
      "type": "string"
    },
    "end_location": {
      "type": "string"
    },
    "client_name": {
      "type": "string",
      "description": "Associated client"
    },
    "purpose": {
      "type": "string",
      "description": "Purpose of trip"
    },
    "start_odometer": {
      "type": "number"
    },
    "end_odometer": {
      "type": "number"
    },
    "distance_km": {
      "type": "number",
      "description": "Distance in km"
    },
    "assigned_bul": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "start_location",
    "end_location"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management"
              ]
            }
          }
        }
      ]
    }
  }
}