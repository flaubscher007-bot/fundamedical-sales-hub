{
  "name": "PricingProposal",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "proposal_number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "discount_percent": {
      "type": "number"
    },
    "final_amount": {
      "type": "number"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "feasibility_notes": {
      "type": "string",
      "description": "Feasibility analysis notes"
    },
    "feasibility_score": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ],
      "description": "Feasibility rating"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Sent",
        "Accepted",
        "Declined",
        "Expired"
      ],
      "default": "Draft"
    },
    "assigned_bul": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "title"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management"
              ]
            }
          }
        }
      ]
    }
  }
}