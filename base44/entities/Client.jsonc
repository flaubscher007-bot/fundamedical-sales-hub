{
  "name": "Client",
  "type": "object",
  "properties": {
    "firm_name": {
      "type": "string"
    },
    "account_status": {
      "type": "string"
    },
    "activity_status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "INACTIVE",
        "Prospect"
      ],
      "default": "ACTIVE"
    },
    "assigned_bul": {
      "type": "string"
    },
    "case_administrator": {
      "type": "string"
    },
    "finance_clerk": {
      "type": "string"
    },
    "business_unit_leader": {
      "type": "string"
    },
    "contact_person": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "finance_email": {
      "type": "string"
    },
    "legal_clerk_emails": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "directors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "landline": {
            "type": "string"
          },
          "cellphone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "description": "Director contacts (multiple allowed)"
    },
    "attorneys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "landline": {
            "type": "string"
          },
          "cellphone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "description": "Attorney contacts (multiple allowed)"
    },
    "legal_secretaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "landline": {
            "type": "string"
          },
          "cellphone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "description": "Legal secretary contacts (multiple allowed)"
    },
    "finance_persons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "designation": {
            "type": "string"
          },
          "landline": {
            "type": "string"
          },
          "cellphone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "description": "Finance person contacts (multiple allowed)"
    },
    "address": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "province": {
      "type": "string",
      "enum": [
        "Western Cape",
        "KwaZulu-Natal",
        "Gauteng",
        "Eastern Cape",
        "Free State",
        "Limpopo",
        "Mpumalanga",
        "North West",
        "Northern Cape"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "Personal Injury",
        "Medical Negligence",
        "Class Action",
        "COIDA",
        "MVA/RAF",
        "General"
      ]
    },
    "special_requirements": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "last_contact_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "firm_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "data.business_unit_leader": "{{user.full_name}}"
        },
        {
          "data.case_administrator": "{{user.full_name}}"
        },
        {
          "data.finance_clerk": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "Sales Manager",
                "senior_management",
                "bul_manager",
                "kac",
                "finance_user"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "data.business_unit_leader": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "Sales Manager",
                "senior_management",
                "bul_manager",
                "kac"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "Sales Manager",
                "senior_management"
              ]
            }
          }
        }
      ]
    }
  }
}