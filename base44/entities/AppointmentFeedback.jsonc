{
  "name": "AppointmentFeedback",
  "type": "object",
  "properties": {
    "appointment_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "rating": {
      "type": "number",
      "description": "1-5 star rating"
    },
    "feedback_text": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "Positive",
        "Neutral",
        "Negative"
      ],
      "default": "Neutral"
    },
    "recorded_by": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "date"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.recorded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.recorded_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    }
  }
}