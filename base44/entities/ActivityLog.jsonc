{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "competitor_id": {
      "type": "string",
      "description": "ID of the competitor"
    },
    "competitor_name": {
      "type": "string",
      "description": "Competitor name (denormalized)"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "Interaction",
        "Legal Case",
        "Major Update",
        "Market Activity",
        "Partnership",
        "Other"
      ],
      "description": "Type of activity"
    },
    "title": {
      "type": "string",
      "description": "Brief title of the activity"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the activity"
    },
    "activity_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the activity"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "In Progress",
        "Completed",
        "On Hold"
      ],
      "default": "Completed",
      "description": "Status of the activity"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "competitor_id",
    "competitor_name",
    "activity_type",
    "title",
    "activity_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management",
            "bul_manager"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$ne": ""
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management",
            "bul_manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "senior_management"
          ]
        }
      }
    }
  }
}