{
  "name": "MediaAsset",
  "type": "object",
  "properties": {
    "file_url": {
      "type": "string",
      "description": "Uploaded file URL"
    },
    "file_name": {
      "type": "string",
      "description": "Original file name"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video"
      ],
      "description": "Type of media"
    },
    "file_size_kb": {
      "type": "number",
      "description": "File size in KB"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "User-defined tags for organizing"
    },
    "category": {
      "type": "string",
      "enum": [
        "Brand",
        "Experts",
        "Events",
        "Services",
        "Testimonials",
        "Infographics",
        "Other"
      ],
      "default": "Other",
      "description": "Content category"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Platforms this asset is best suited for"
    },
    "description": {
      "type": "string",
      "description": "Optional description / caption idea"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail for video assets"
    }
  },
  "required": [
    "file_url",
    "media_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management",
            "bul_manager"
          ]
        }
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$ne": ""
        }
      }
    },
    "update": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management",
            "bul_manager"
          ]
        }
      }
    },
    "delete": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "Sales Manager",
            "senior_management"
          ]
        }
      }
    }
  }
}