{
  "name": "EntertainmentProposal",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Lunch",
        "Dinner",
        "Golf Day",
        "Conference",
        "Networking Event",
        "Team Building",
        "Other"
      ]
    },
    "proposed_date": {
      "type": "string",
      "format": "date"
    },
    "venue": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number"
    },
    "number_of_guests": {
      "type": "number"
    },
    "purpose": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Draft",
        "Submitted",
        "Approved",
        "Rejected"
      ],
      "default": "Draft"
    },
    "assigned_bul": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "event_type"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_bul": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management",
                "bul_manager"
              ]
            }
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": {
              "$in": [
                "admin",
                "Sales Manager",
                "senior_management"
              ]
            }
          }
        }
      ]
    }
  }
}